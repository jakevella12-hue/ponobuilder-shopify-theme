<!-- Hero Section -->
<section class="bg-gradient-to-br from-blue-600 to-blue-800 pt-24 text-white">
  <div class="container mx-auto px-6 py-16">
    <div class="max-w-3xl">
      <h1 class="mb-4 text-5xl font-bold">Request a Quote</h1>
      <p class="text-xl text-blue-100">
        Tell us about your project and we'll provide a detailed quote within 24 hours.
      </p>
    </div>
  </div>
</section>

<!-- Quote Form Section -->
<section class="bg-white py-20">
  <div class="container mx-auto px-6">
    <div class="grid gap-12 lg:grid-cols-2">
      <!-- Form -->
      <div>
        <div class="card border-gray-200">
          <div class="card-content p-8">
            <h2 class="mb-6 text-2xl font-bold text-gray-900">Project Details</h2>

            {% form 'contact', class: 'space-y-6' %}
              {% if form.posted_successfully? %}
                <div class="rounded-lg bg-green-50 border border-green-200 p-4">
                  <p class="text-green-800 font-semibold">Thank you for your inquiry!</p>
                  <p class="text-green-700 text-sm mt-1">We'll review your request and get back to you within 24 hours.</p>
                </div>
              {% endif %}

              {% if form.errors %}
                <div class="rounded-lg bg-red-50 border border-red-200 p-4">
                  <p class="text-red-800 font-semibold">Please fix the following errors:</p>
                  <ul class="list-disc list-inside text-red-700 text-sm mt-2">
                    {% for field in form.errors %}
                      <li>{{ field | capitalize }} {{ form.errors.messages[field] }}</li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}

              <div>
                <label for="contact_name" class="block mb-2 text-sm font-semibold text-gray-900">
                  Full Name *
                </label>
                <input
                  type="text"
                  id="contact_name"
                  name="contact[name]"
                  required
                  class="input w-full"
                  placeholder="John Smith"
                >
              </div>

              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="contact_email" class="block mb-2 text-sm font-semibold text-gray-900">
                    Email *
                  </label>
                  <input
                    type="email"
                    id="contact_email"
                    name="contact[email]"
                    required
                    class="input w-full"
                    placeholder="john@example.com"
                  >
                </div>

                <div>
                  <label for="contact_phone" class="block mb-2 text-sm font-semibold text-gray-900">
                    Phone Number
                  </label>
                  <input
                    type="tel"
                    id="contact_phone"
                    name="contact[phone]"
                    class="input w-full"
                    placeholder="(555) 123-4567"
                  >
                </div>
              </div>

              <div>
                <label for="contact_company" class="block mb-2 text-sm font-semibold text-gray-900">
                  Company / Organization
                </label>
                <input
                  type="text"
                  id="contact_company"
                  name="contact[company]"
                  class="input w-full"
                  placeholder="Your Company Name"
                >
              </div>

              <div>
                <label for="contact_project_type" class="block mb-2 text-sm font-semibold text-gray-900">
                  Project Type *
                </label>
                <select
                  id="contact_project_type"
                  name="contact[project_type]"
                  required
                  class="input w-full"
                >
                  <option value="">Select project type</option>
                  <option value="marina">Marina / Harbor</option>
                  <option value="dock">Private Dock</option>
                  <option value="platform">Floating Platform</option>
                  <option value="ramp">Access Ramp</option>
                  <option value="custom">Custom Solution</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div>
                <label for="contact_budget" class="block mb-2 text-sm font-semibold text-gray-900">
                  Estimated Budget
                </label>
                <select
                  id="contact_budget"
                  name="contact[budget]"
                  class="input w-full"
                >
                  <option value="">Select budget range</option>
                  <option value="under-5k">Under $5,000</option>
                  <option value="5k-10k">$5,000 - $10,000</option>
                  <option value="10k-25k">$10,000 - $25,000</option>
                  <option value="25k-50k">$25,000 - $50,000</option>
                  <option value="over-50k">Over $50,000</option>
                </select>
              </div>

              <div>
                <label for="contact_timeline" class="block mb-2 text-sm font-semibold text-gray-900">
                  Timeline
                </label>
                <select
                  id="contact_timeline"
                  name="contact[timeline]"
                  class="input w-full"
                >
                  <option value="">Select timeline</option>
                  <option value="urgent">Urgent (1-2 weeks)</option>
                  <option value="soon">Soon (1-2 months)</option>
                  <option value="flexible">Flexible (3-6 months)</option>
                  <option value="planning">Just Planning</option>
                </select>
              </div>

              <div>
                <label for="contact_message" class="block mb-2 text-sm font-semibold text-gray-900">
                  Project Description *
                </label>
                <textarea
                  id="contact_message"
                  name="contact[body]"
                  required
                  rows="6"
                  class="input w-full"
                  placeholder="Please describe your project requirements, site specifications, and any specific needs..."
                ></textarea>
              </div>

              <div class="text-sm text-gray-600">
                * Required fields
              </div>

              <button type="submit" class="btn btn-primary btn-lg w-full">
                Submit Quote Request
              </button>
            {% endform %}
          </div>
        </div>
      </div>

      <!-- Info Sidebar -->
      <div class="space-y-8">
        <!-- What to Expect -->
        <div class="card border-gray-200">
          <div class="card-content p-6">
            <h3 class="mb-4 text-xl font-bold text-gray-900">What to Expect</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <svg class="mt-1 h-5 w-5 flex-shrink-0 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <div>
                  <p class="font-semibold text-gray-900">24-Hour Response</p>
                  <p class="text-sm text-gray-600">We'll review your request and respond within one business day</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <svg class="mt-1 h-5 w-5 flex-shrink-0 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <div>
                  <p class="font-semibold text-gray-900">Detailed Quote</p>
                  <p class="text-sm text-gray-600">Itemized pricing, specifications, and delivery timeline</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <svg class="mt-1 h-5 w-5 flex-shrink-0 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
                </svg>
                <div>
                  <p class="font-semibold text-gray-900">Expert Consultation</p>
                  <p class="text-sm text-gray-600">Free consultation with our marine engineering team</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <svg class="mt-1 h-5 w-5 flex-shrink-0 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                <div>
                  <p class="font-semibold text-gray-900">No Obligation</p>
                  <p class="text-sm text-gray-600">Request multiple quotes and compare options</p>
                </div>
              </li>
            </ul>
          </div>
        </div>

        <!-- Contact Info -->
        <div class="card border-gray-200 bg-blue-50">
          <div class="card-content p-6">
            <h3 class="mb-4 text-xl font-bold text-gray-900">Need Help?</h3>
            <p class="mb-4 text-gray-700">
              Prefer to speak with someone directly? Our team is here to help.
            </p>
            <ul class="space-y-3 text-sm">
              <li class="flex items-center gap-3 text-gray-700">
                <svg class="h-5 w-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                info@ponobuilder.com
              </li>
              <li class="flex items-center gap-3 text-gray-700">
                <svg class="h-5 w-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                (555) 123-4567
              </li>
              <li class="flex items-center gap-3 text-gray-700">
                <svg class="h-5 w-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Mon-Fri: 8AM - 6PM EST
              </li>
            </ul>
          </div>
        </div>

        <!-- Trust Badges -->
        <div class="grid grid-cols-2 gap-4">
          <div class="card border-gray-200 text-center">
            <div class="card-content p-4">
              <svg class="h-8 w-8 mx-auto mb-2 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <p class="text-xs font-semibold text-gray-900">10-Year Warranty</p>
            </div>
          </div>
          <div class="card border-gray-200 text-center">
            <div class="card-content p-4">
              <svg class="h-8 w-8 mx-auto mb-2 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
              </svg>
              <p class="text-xs font-semibold text-gray-900">Free Shipping</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
